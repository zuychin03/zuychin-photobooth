# Friends-only release: local tools work without a database. Use full only after
# backend setup and acceptance. Production defaults to local when omitted.
PB_RELEASE_MODE=local

# ─── Supabase ─────────────────────────────────────────────
# Legacy signalling and optional accounts. V2 rooms/projects/events require
# the reviewed numbered migrations as well as the baseline setup.
# Without these, the booth still works; account features stay hidden.
# Full walkthrough: README "Setting up Supabase"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, bypasses RLS. Required for authorised V2 server operations and workers.
# P1 also requires the lifecycle schema and an explicitly configured DB timezone.
SUPABASE_SERVICE_ROLE_KEY=

# Only for sharing one login across sibling apps served under one parent
# domain (e.g. .example.com for booth.example.com + gallery.example.com):
# set to that parent with a leading dot, identically in every app.
# Leave BLANK on localhost or a standalone deploy.
NEXT_PUBLIC_COOKIE_DOMAIN=

# ─── Cloudinary (archive kept strips, optional) ───────────
# Kept strips use durable authenticated archive jobs. Source removal requires
# verified archive persistence. Missing provider configuration preserves the
# original and pending job; it does not claim a completed archive.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── TURN (cross-network rooms) ───────────────────────────
# URL MUST start with turn: or turns:. A bare host:port is silently ignored.
# Comma-separate multiple transports (UDP, TCP, TLS) for restrictive networks.
# e.g. turn:relay.example.com:3478,turn:relay.example.com:3478?transport=tcp
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ─── Web push notifications (optional) ────────────────────
# Generate a pair once with `npx web-push generate-vapid-keys` and set the
# same values in every environment. Enables the notification bell in the
# vault: relay your-turn nudges, new-strip alerts, photo-date reminders.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, mailto: or https: form.
VAPID_SUBJECT=mailto:you@example.com

# ─── Photo-date reminders (optional) ──────────────────────
# Resend API key (https://resend.com) for sending reminder emails.
RESEND_API_KEY=
# Verified sender. Defaults to Resend's onboarding sender for testing.
REMINDER_FROM=Zuychin Photobooth <onboarding@resend.dev>
# Shared secret the cron scheduler sends as `Authorization: Bearer <secret>`
# Query-string secrets are not accepted.
CRON_SECRET=

# Canonical HTTPS origin, required for cloud mutations and reminder links.
# Example: https://booth.example.com (no path or trailing query).
PB_PUBLIC_ORIGIN=

# Feature switches stay off until their schema, provider and activation checks pass.
# These are examples only; no scheduler, quota allocation or hosted setup is installed.
PB_EVENTS_ENABLED=false
# Owner expiry notifications additionally require migration 021 and explicit channel opt-in.
PB_EVENT_REMINDERS_ENABLED=false
# Event uploads additionally require migration019 and a fresh verified worker heartbeat.
# No scheduler is installed here. See docs/development/P7_EVENT_WORKER_RUNBOOK.md.
# Event transport requires migration 016 and a stable random secret (32+ characters).
PB_EVENT_TRANSPORT_SECRET=
# Production proxy must overwrite this single client-IP header; no forwarded lists.
PB_EVENT_TRUSTED_IP_HEADER=
PB_CLOUD_PROJECTS_ENABLED=false
PB_CHALLENGES_ENABLED=false
PB_ROOM_V2_ENABLED=false
# Room IP-rate HMAC secret, at least 32 characters and separate from event transport.
PB_ROOM_RATE_SECRET=
# Trusted ingress must overwrite this single-IP header. Never trust caller-provided values.
PB_ROOM_TRUSTED_IP_HEADER=
# Memories require 006/011/013; rituals additionally require 009/010 and the reminder cron.
PB_MEMORIES_ENABLED=false
# Private voice captions require migration 014, configured deployment bytes and provider checks.
PB_VOICE_CAPTIONS_ENABLED=false

# Project, event and voice deployment byte budgets are service-only database
# configuration (002/005/014), default zero. Partition actual provider capacity;
# there are no PB_*_MAX_BYTES environment overrides. See README activation steps.
